/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('backend:server');
var http = require('http');

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3001');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

// --- Add Socket.IO setup ---
const { Server } = require("socket.io");
const io = new Server(server, { cors: { origin: "*" } });
app.set('io', io); // Make io available in routes

io.on('connection', (socket) => {
  console.log('Android client connected:', socket.id);

  socket.on('message', (data) => {
    console.log('Received from Android:', data);
    // Echo back or broadcast
    socket.emit('message', 'Hello from Node.js backend!');
  });

  socket.on('disconnect', () => {
    console.log('Android client disconnected:', socket.id);
  });
});

// --- MongoDB Change Stream: broadcast any external write to "Registration Forms" ---
// This ensures live updates reach the frontend even when changes come from
// WooCommerce / Django or any other source that bypasses the Node.js API routes.
const { MongoClient } = require('mongodb');
const CHANGE_STREAM_URI = "mongodb+srv://MosesLee:Mlxy%406695@company-management-syst.ulotbgi.mongodb.net/?retryWrites=true&w=majority&appName=Company-Management-System";

let _changeStreamClient = null;

async function watchRegistrationForms(io) {
  // Clean up any previous client before reconnecting
  if (_changeStreamClient) {
    try { await _changeStreamClient.close(); } catch (_) {}
    _changeStreamClient = null;
  }

  const client = new MongoClient(CHANGE_STREAM_URI);
  _changeStreamClient = client;

  try {
    await client.connect();
    const collection = client
      .db('Company-Management-System')
      .collection('Registration Forms');

    const changeStream = collection.watch([], { fullDocument: 'updateLookup' });
    console.log('[ChangeStream] Watching "Registration Forms" collection');

    changeStream.on('change', (change) => {
      if (['insert', 'update', 'replace'].includes(change.operationType)) {
        // Emit the _id of the changed document so clients can do a targeted single-row refresh
        // instead of reloading the entire table.
        const docId = change.documentKey?._id?.toString?.() || String(change.documentKey?._id || '');
        io.emit('registration', {
          type: 'db-change',
          operation: change.operationType,
          id: docId || null,
        });
      }
    });

    changeStream.on('error', (err) => {
      console.error('[ChangeStream] Error:', err.message);
      setTimeout(() => watchRegistrationForms(io), 5000);
    });

    changeStream.on('close', () => {
      console.log('[ChangeStream] Stream closed, reconnecting...');
      setTimeout(() => watchRegistrationForms(io), 5000);
    });

  } catch (err) {
    console.error('[ChangeStream] Failed to connect:', err.message);
    setTimeout(() => watchRegistrationForms(io), 5000);
  }
}

// Start the change stream once the server is listening
server.on('listening', () => {
  watchRegistrationForms(io);
});


/**
 * Event listener for HTTP server "listening" event.
 */
//Please
function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
